# Clave secreta para sesiones Flask (obligatoria en producción)
SECRET_KEY=cambiar-por-clave-segura

# Seguridad de login (opcional)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# SESSION_LIFETIME_HOURS=12
# SESSION_COOKIE_SECURE=1

# =============================================================================
# PostgreSQL
# =============================================================================
# RECOMENDADO para desarrollo: siempre localhost.
# Si apuntás a Render (producción), la app lee/escribe datos reales.
# NUNCA corras setup/migrate/limpiar_turnos contra producción.
#
# Local (desarrollo / app / migrate / setup):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/colom_bobbiesi
#
# Producción — SOLO para el backup programado (lectura). NO uses esta URL
# en DATABASE_URL ni para migrate/setup/limpiar_turnos.
BACKUP_DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB

# Migraciones de esquema (seguro): alembic upgrade head
# Importar JSON → solo localhost: python scripts/migrate_json_to_postgres.py --write
# Backup (usa BACKUP_DATABASE_URL si está definida):
#   python scripts/backup_postgres.py --output-dir "C:\Backups\colom-bobbiesi"

# API pública de turnos — solo para tu sitio web
PUBLIC_API_KEY=generar-clave-segura-con-secrets-token-urlsafe
PUBLIC_API_CORS_ORIGIN=https://www.tu-sitio.com
PUBLIC_API_MAX_DIAS=60
PUBLIC_API_MAX_DIAS_RANGO=31
PUBLIC_API_CACHE_SECONDS=45

# =============================================================================
# SMTP — aviso al consultorio cuando se reserva un turno online
# (Render → Environment del servicio web; App Password de Google, no la clave normal)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=colombobbiesi@gmail.com
SMTP_PASS=
SMTP_FROM=Colom Bobbiesi Turnos <colombobbiesi@gmail.com>
SMTP_TO=colombobbiesi@gmail.com
